# Copy this file to .env. Never commit .env or paste secrets into chat.

# PAPER execution is mandatory. This controls market data only.
TRADEFORGE_MARKET_DATA_MODE=LIVE
TRADEFORGE_MARKET_DATA_PROVIDER=ALPACA
TRADEFORGE_ALPACA_FEED=iex

# Alpaca official market-data credentials.
# Generate them in the official Alpaca dashboard.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Alternative official Massive/Polygon market-data provider.
# Use this instead of the Alpaca variables above if selected.
# TRADEFORGE_MARKET_DATA_PROVIDER=POLYGON
# MASSIVE_API_KEY=
